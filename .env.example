# =====================================================================
#  xcBlogs 一键部署配置
#  复制为 .env 后按需修改：cp .env.example .env
#  ⚠️ 所有密码请务必改成你自己的强随机值，不要直接用示例值。
# =====================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=xcblogs
MYSQL_USER=xcblogs
MYSQL_PASSWORD=change-me-db-password

# ---------- 管理端登录 ----------
# 首次启动时后端会用这个密码自动创建 admin 账号
ADMIN_PASSWORD=change-me-admin-password
# 管理端会话 Cookie 的签名密钥，建议 openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- 服务间鉴权 ----------
# 管理端调用后端 API 时携带的内部令牌，建议 openssl rand -hex 32
CMS_TOKEN=change-me-to-a-long-random-string

# ---------- 对外端口 ----------
BLOG_PORT=3000
MANAGER_PORT=3001

# ---------- 其它 ----------
TZ=Asia/Shanghai
# 后端允许的跨域来源，逗号分隔；默认 * 已足够，因为后端不对公网暴露
CORS_ORIGINS=*
# 会话 Cookie 是否加 Secure 标志。
# 直接用 http://ip:3001 访问时保持 false，否则浏览器不会回传 Cookie，会一直跳回登录页。
# 在前面挂了 HTTPS 反向代理之后，改成 true。
COOKIE_SECURE=false
